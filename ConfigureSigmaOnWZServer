cat > "${UPDATE_WRAPPER}" <<'SHEOF'
#!/usr/bin/env bash
set -euo pipefail

ROOT="/opt/gsc-sigma"
UPSTREAM="${ROOT}/upstream"
LOG_DIR="${ROOT}/logs"
URL="https://github.com/SigmaHQ/sigma/archive/refs/heads/master.tar.gz"

APPLY=0

for arg in "$@"; do
    case "$arg" in
        --apply) APPLY=1 ;;
        *)
            echo "Usage: $0 [--apply]"
            exit 1
            ;;
    esac
done

[[ "${EUID}" -eq 0 ]] || {
    echo "[ERROR] Run with sudo/root."
    exit 1
}

mkdir -p "${LOG_DIR}"

tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT

archive="${tmp}/sigma.tar.gz"

echo "[INFO] Downloading current SigmaHQ rule content..."
curl -fL --retry 3 --connect-timeout 20 \
    "${URL}" \
    -o "${archive}"

tar -xzf "${archive}" -C "${tmp}"

src="$(find "${tmp}" -maxdepth 3 -type d -path '*/rules/windows' | head -n 1)"

if [[ -z "${src}" || ! -d "${src}" ]]; then
    echo "[ERROR] Could not find SigmaHQ rules/windows in downloaded archive."
    exit 1
fi

new_upstream="${tmp}/windows"
mkdir -p "${new_upstream}"
cp -a "${src}/." "${new_upstream}/"

# Replace upstream rule content atomically.
old_upstream="${ROOT}/upstream.old"

rm -rf "${old_upstream}"
if [[ -d "${UPSTREAM}" ]]; then
    mv "${UPSTREAM}" "${old_upstream}"
fi

mv "${new_upstream}" "${UPSTREAM}"

if [[ "${APPLY}" -eq 1 ]]; then
    if /opt/gsc-sigma/bin/gsc-sigma-compile --include-upstream --apply; then
        rm -rf "${old_upstream}"
        echo "[OK] SigmaHQ update compiled and applied."
    else
        echo "[ERROR] New upstream content did not apply cleanly."
        rm -rf "${UPSTREAM}"
        if [[ -d "${old_upstream}" ]]; then
            mv "${old_upstream}" "${UPSTREAM}"
        fi
        exit 1
    fi
else
    rm -rf "${old_upstream}"
    /opt/gsc-sigma/bin/gsc-sigma-compile --include-upstream
    echo "[INFO] Upstream rules updated and compiled, but not installed into Wazuh."
fi
