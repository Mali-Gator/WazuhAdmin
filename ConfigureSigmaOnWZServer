#!/usr/bin/env bash
#
# Granite Shield Cyber - Native Wazuh Sigma Support
#
# PURPOSE
# -------
# This script adds Sigma-rule capability to an existing Wazuh manager without
# installing another SIEM, detection engine, dashboard, agent, or long-running
# third-party service.
#
# What it installs:
#   1. A local Sigma rule workspace under /opt/gsc-sigma
#   2. A small GSC Sigma -> Wazuh converter written in Python
#   3. A manual-rule folder for your own Sigma YAML files
#   4. An OPTIONAL SigmaHQ Windows-rule updater
#   5. An OPTIONAL systemd timer for automatic rule-content updates
#   6. Native Wazuh XML rules under /var/ossec/etc/rules/
#
# IMPORTANT LIMITATION
# --------------------
# Sigma and Wazuh do not have identical rule languages. This converter is
# intentionally "fail closed":
#
#   - Supported Sigma rules are converted to native Wazuh rules.
#   - Unsupported or ambiguous Sigma rules are SKIPPED and reported.
#   - The script never silently changes the meaning of a rule just to make it
#     compile.
#
# This first version focuses on the Windows telemetry we have already enabled:
#   Sysmon 1,3,6,8,9,10,11,12-14,17-18,19-21,22,25,26
#   PowerShell 4103/4104
#
# DEPENDENCIES
# ------------
# No Sigma CLI, pySigma backend, third-party SIEM, or OpenSearch plugin is
# installed.
#
# The converter uses:
#   - python3
#   - python3-yaml
#   - curl
#   - tar
#
# python3-yaml is only a YAML parser library. It does not run a service.
#
# USAGE
# -----
# Basic setup + one safe local test rule:
#
#   sudo bash setup-gsc-native-sigma.sh
#
# Also download the current SigmaHQ Windows detection-rule CONTENT and compile
# the subset this converter safely supports:
#
#   sudo bash setup-gsc-native-sigma.sh --with-upstream
#
# Enable daily automatic upstream content updates after you have tested the
# resulting detections:
#
#   sudo bash setup-gsc-native-sigma.sh --with-upstream --enable-auto-update
#
# After installation:
#
#   # Put your own Sigma YAML files here:
#   /opt/gsc-sigma/manual/
#
#   # Compile/apply local rules:
#   sudo /opt/gsc-sigma/bin/gsc-sigma-compile --apply
#
#   # Manually refresh SigmaHQ content:
#   sudo /opt/gsc-sigma/bin/gsc-sigma-update --apply
#
# WAZUH DASHBOARD QUERY
# ---------------------
#   rule.groups:gsc_sigma
#

set -euo pipefail

# ---------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------

ROOT="/opt/gsc-sigma"
BIN_DIR="${ROOT}/bin"
MANUAL_DIR="${ROOT}/manual"
UPSTREAM_DIR="${ROOT}/upstream"
GENERATED_DIR="${ROOT}/generated"
STATE_DIR="${ROOT}/state"
LOG_DIR="${ROOT}/logs"
BACKUP_DIR="${ROOT}/backups"

WAZUH_RULE_DIR="/var/ossec/etc/rules"
WAZUH_RULE_FILE="${WAZUH_RULE_DIR}/gsc_sigma_rules.xml"

COMPILER="${BIN_DIR}/gsc_sigma_compile.py"
COMPILE_WRAPPER="${BIN_DIR}/gsc-sigma-compile"
UPDATE_WRAPPER="${BIN_DIR}/gsc-sigma-update"

SIGMAHQ_ARCHIVE_URL="https://github.com/SigmaHQ/sigma/archive/refs/heads/master.tar.gz"

WITH_UPSTREAM=0
ENABLE_AUTO_UPDATE=0

for arg in "$@"; do
    case "$arg" in
        --with-upstream)
            WITH_UPSTREAM=1
            ;;
        --enable-auto-update)
            ENABLE_AUTO_UPDATE=1
            WITH_UPSTREAM=1
            ;;
        -h|--help)
            sed -n '1,95p' "$0"
            exit 0
            ;;
        *)
            echo "[ERROR] Unknown argument: $arg"
            echo "Use: $0 [--with-upstream] [--enable-auto-update]"
            exit 1
            ;;
    esac
done

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

step() {
    echo
    echo "=== $* ==="
}

ok() {
    echo "[OK] $*"
}

warn() {
    echo "[WARN] $*"
}

die() {
    echo "[ERROR] $*" >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Safety checks
# ---------------------------------------------------------------------------

[[ "${EUID}" -eq 0 ]] || die "Run this script with sudo/root."

[[ -x /var/ossec/bin/wazuh-analysisd ]] \
    || die "This does not appear to be a Wazuh manager: /var/ossec/bin/wazuh-analysisd is missing."

systemctl list-unit-files wazuh-manager.service >/dev/null 2>&1 \
    || die "wazuh-manager.service was not found."

# ---------------------------------------------------------------------------
# Install only generic parser/download dependencies.
# No Sigma runtime or external detection product is installed.
# ---------------------------------------------------------------------------

step "Checking local dependencies"

need_apt=0

command -v python3 >/dev/null 2>&1 || need_apt=1
command -v curl    >/dev/null 2>&1 || need_apt=1
command -v tar     >/dev/null 2>&1 || need_apt=1

if ! python3 -c 'import yaml' >/dev/null 2>&1; then
    need_apt=1
fi

if [[ "${need_apt}" -eq 1 ]]; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y python3 python3-yaml curl tar
fi

python3 -c 'import yaml' >/dev/null 2>&1 \
    || die "Python YAML parser is still unavailable."

ok "Dependencies available"

# ---------------------------------------------------------------------------
# Create workspace.
# ---------------------------------------------------------------------------

step "Creating GSC Sigma workspace"

mkdir -p \
    "${BIN_DIR}" \
    "${MANUAL_DIR}" \
    "${UPSTREAM_DIR}" \
    "${GENERATED_DIR}" \
    "${STATE_DIR}" \
    "${LOG_DIR}" \
    "${BACKUP_DIR}" \
    "${WAZUH_RULE_DIR}"

chmod 750 "${ROOT}" "${BIN_DIR}" "${STATE_DIR}" "${BACKUP_DIR}"
chmod 755 "${MANUAL_DIR}" "${UPSTREAM_DIR}" "${GENERATED_DIR}" "${LOG_DIR}"

ok "Workspace created at ${ROOT}"

# ---------------------------------------------------------------------------
# Create the Sigma -> Wazuh compiler.
#
# The converter supports a deliberately conservative subset of Sigma:
#
#   Conditions:
#     selection
#     selection_a or selection_b
#     selection_a and selection_b
#     1 of selection_*
#     all of selection_*
#
#   Field modifiers:
#     contains
#     startswith
#     endswith
#     re
#     all
#
# More complex conditions (especially filters/correlation) are skipped rather
# than approximated incorrectly.
# ---------------------------------------------------------------------------

step "Installing native Sigma-to-Wazuh converter"

cat > "${COMPILER}" <<'PYEOF'
