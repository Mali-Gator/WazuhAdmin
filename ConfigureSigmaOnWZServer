#!/usr/bin/env bash
set -euo pipefail

ROOT="/opt/gsc-sigma"
GENERATED="${ROOT}/generated/gsc_sigma_rules.xml"
REPORT="${ROOT}/generated/compile-report.json"
TARGET="/var/ossec/etc/rules/gsc_sigma_rules.xml"
BACKUPS="${ROOT}/backups"
STAMP="$(date +%Y%m%d-%H%M%S)"

INCLUDE_UPSTREAM=0
APPLY=0

for arg in "$@"; do
    case "$arg" in
        --include-upstream) INCLUDE_UPSTREAM=1 ;;
        --apply) APPLY=1 ;;
        *)
            echo "Usage: $0 [--include-upstream] [--apply]"
            exit 1
            ;;
    esac
done

[[ "${EUID}" -eq 0 ]] || {
    echo "[ERROR] Run with sudo/root."
    exit 1
}

args=()
[[ "${INCLUDE_UPSTREAM}" -eq 1 ]] && args+=(--include-upstream)

/opt/gsc-sigma/bin/gsc_sigma_compile.py "${args[@]}"

if [[ "${APPLY}" -ne 1 ]]; then
    echo
    echo "[INFO] Compile only. Nothing was installed into Wazuh."
    echo "[INFO] Review: ${REPORT}"
    exit 0
fi

mkdir -p "${BACKUPS}"

old_hash=""
new_hash="$(sha256sum "${GENERATED}" | awk '{print $1}')"

if [[ -f "${TARGET}" ]]; then
    old_hash="$(sha256sum "${TARGET}" | awk '{print $1}')"
fi

if [[ "${old_hash}" == "${new_hash}" ]]; then
    echo "[OK] Generated Sigma Wazuh rules are unchanged. No restart needed."
    exit 0
fi

backup=""

if [[ -f "${TARGET}" ]]; then
    backup="${BACKUPS}/gsc_sigma_rules.xml.${STAMP}.bak"
    cp -a "${TARGET}" "${backup}"
    echo "[OK] Existing Sigma rule file backed up to ${backup}"
fi

cp -a "${GENERATED}" "${TARGET}"
chown root:wazuh "${TARGET}" 2>/dev/null || true
chmod 640 "${TARGET}"

echo "[INFO] Validating Wazuh analysis configuration..."

if ! /var/ossec/bin/wazuh-analysisd -t; then
    echo "[ERROR] Wazuh validation failed. Rolling back."

    if [[ -n "${backup}" && -f "${backup}" ]]; then
        cp -a "${backup}" "${TARGET}"
    else
        rm -f "${TARGET}"
    fi

    exit 1
fi

echo "[OK] Wazuh validation passed."

restart_failed=0
if ! systemctl restart wazuh-manager; then
    restart_failed=1
else
    sleep 4
    systemctl is-active --quiet wazuh-manager || restart_failed=1
fi

if [[ "${restart_failed}" -eq 1 ]]; then
    echo "[ERROR] Wazuh manager failed or timed out after rule deployment. Rolling back."

    systemctl stop wazuh-manager >/dev/null 2>&1 || true
    pkill -f '/var/ossec/bin/wazuh-analysisd -t' >/dev/null 2>&1 || true

    if [[ -n "${backup}" && -f "${backup}" ]]; then
        cp -a "${backup}" "${TARGET}"
    else
        rm -f "${TARGET}"
    fi

    systemctl reset-failed wazuh-manager || true
    if ! systemctl start wazuh-manager; then
        echo "[CRITICAL] Previous rules were restored, but Wazuh still did not start."
        echo "[CRITICAL] Inspect: journalctl -u wazuh-manager -n 100 --no-pager"
        exit 2
    fi

    echo "[OK] Previous rules restored and wazuh-manager recovered."
    exit 1
fi

echo "[OK] Sigma-derived Wazuh rules applied successfully."
echo "[OK] wazuh-manager is running."
