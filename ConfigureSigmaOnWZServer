SUPPORTED_MODIFIERS = {
    "contains",
    "startswith",
    "endswith",
    "re",
    "all",
}


class UnsupportedRule(Exception):
    pass


def normalize_scalar(value: Any) -> str:
    if value is None:
        return ""
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def regex_for_value(value: Any, modifiers: list[str]) -> str:
    """Convert one Sigma scalar into a PCRE2 pattern."""
    text = normalize_scalar(value)

    if "re" in modifiers:
        return text

    escaped = re.escape(text)

    if "contains" in modifiers:
        body = escaped
    elif "startswith" in modifiers:
        body = "^" + escaped
    elif "endswith" in modifiers:
        body = escaped + "$"
    else:
        body = "^" + escaped + "$"

    # Windows Sigma string comparisons are normally case insensitive.
    return "(?i)" + body


def convert_field_condition(field_expr: str, value: Any) -> list[tuple[str, str]]:
    """
    Convert:
        Image|endswith: '\\powershell.exe'
    into one or more:
        (win.eventdata.image, PCRE2)
    """

    parts = field_expr.split("|")
    sigma_field = parts[0].strip()
    modifiers = [p.strip().lower() for p in parts[1:] if p.strip()]

    unknown = [m for m in modifiers if m not in SUPPORTED_MODIFIERS]
    if unknown:
        raise UnsupportedRule(
            f"unsupported modifier(s) on {sigma_field}: {', '.join(unknown)}"
        )

    wazuh_field = FIELD_MAP.get(sigma_field.lower())
    if not wazuh_field:
        raise UnsupportedRule(f"unsupported field: {sigma_field}")

    values = value if isinstance(value, list) else [value]

    if not values:
        raise UnsupportedRule(f"empty value list for field: {sigma_field}")

    # "|all" means every listed value must match.
    if "all" in modifiers:
        return [
            (wazuh_field, regex_for_value(v, modifiers))
            for v in values
        ]

    # Without "|all", a Sigma list is OR. Put alternatives in one regex.
    patterns = [regex_for_value(v, modifiers) for v in values]

    if len(patterns) == 1:
        return [(wazuh_field, patterns[0])]

    # Strip duplicate (?i) markers before building one alternation.
    cleaned = []
    for pattern in patterns:
        if pattern.startswith("(?i)"):
            pattern = pattern[4:]
        cleaned.append(f"(?:{pattern})")

    return [(wazuh_field, "(?i)(?:" + "|".join(cleaned) + ")")]


def expand_selection(selection: Any) -> list[list[tuple[str, str]]]:
    """
    Return OR branches.

    A mapping becomes one branch.
    A list of mappings becomes multiple OR branches.
    """

    if isinstance(selection, dict):
        branch: list[tuple[str, str]] = []
        for field_expr, value in selection.items():
            branch.extend(convert_field_condition(str(field_expr), value))
        return [branch]

    if isinstance(selection, list):
        branches = []
        for item in selection:
            if not isinstance(item, dict):
                raise UnsupportedRule(
                    "keyword/list detections without fields are not supported"
                )
            branches.extend(expand_selection(item))
        return branches

    raise UnsupportedRule(
        "selection must be a field mapping or a list of field mappings"
    )


def identifiers_matching(detection: dict[str, Any], glob_expr: str) -> list[str]:
    # Support patterns such as selection_*.
    regex = "^" + re.escape(glob_expr).replace(r"\*", ".*") + "$"
    return sorted(
        k
        for k in detection.keys()
        if k != "condition" and re.match(regex, k)
    )


def condition_to_branches(detection: dict[str, Any]) -> list[list[tuple[str, str]]]:
    """
    Support a safe subset of Sigma conditions.

    Supported examples:
      selection
      selection_a or selection_b
      selection_a and selection_b
      1 of selection_*
      all of selection_*

    Conditions containing NOT, parentheses, thresholds other than "1 of",
    or Sigma correlation syntax are intentionally rejected.
    """

    condition = detection.get("condition")
    if not isinstance(condition, str):
        raise UnsupportedRule("condition must be a string")

    condition = " ".join(condition.strip().split())

    if re.search(r"\bnot\b", condition, re.I):
        raise UnsupportedRule("NOT/filter conditions are not translated in v1")

    if "(" in condition or ")" in condition:
        raise UnsupportedRule("parenthesized conditions are not translated in v1")

    # 1 of selection_*
    match = re.fullmatch(r"1 of ([A-Za-z0-9_*.-]+)", condition, re.I)
    if match:
        names = identifiers_matching(detection, match.group(1))
        if not names:
            raise UnsupportedRule("condition matched no selections")

        result = []
        for name in names:
            result.extend(expand_selection(detection[name]))
        return result

    # all of selection_*
    match = re.fullmatch(r"all of ([A-Za-z0-9_*.-]+)", condition, re.I)
    if match:
        names = identifiers_matching(detection, match.group(1))
        if not names:
            raise UnsupportedRule("condition matched no selections")

        # Cartesian merge of possible branches.
        branches: list[list[tuple[str, str]]] = [[]]
        for name in names:
            new_branches = []
            for existing in branches:
                for addition in expand_selection(detection[name]):
                    new_branches.append(existing + addition)
            branches = new_branches
        return branches

    # Pure OR of identifiers.
    if re.fullmatch(
        r"[A-Za-z0-9_.-]+(?:\s+or\s+[A-Za-z0-9_.-]+)+",
        condition,
        re.I,
    ):
        result = []
        for name in re.split(r"\s+or\s+", condition, flags=re.I):
            if name not in detection:
                raise UnsupportedRule(f"unknown selection: {name}")
            result.extend(expand_selection(detection[name]))
        return result

    # Pure AND of identifiers.
    if re.fullmatch(
        r"[A-Za-z0-9_.-]+(?:\s+and\s+[A-Za-z0-9_.-]+)+",
        condition,
        re.I,
    ):
        names = re.split(r"\s+and\s+", condition, flags=re.I)
        branches: list[list[tuple[str, str]]] = [[]]

        for name in names:
            if name not in detection:
                raise UnsupportedRule(f"unknown selection: {name}")

            new_branches = []
            for existing in branches:
                for addition in expand_selection(detection[name]):
                    new_branches.append(existing + addition)
            branches = new_branches

        return branches

    # Single identifier.
    if re.fullmatch(r"[A-Za-z0-9_.-]+", condition):
        if condition not in detection:
            raise UnsupportedRule(f"unknown selection: {condition}")
        return expand_selection(detection[condition])

    raise UnsupportedRule(f"unsupported condition syntax: {condition}")


def logsource_constraints(rule: dict[str, Any]) -> tuple[str | None, str]:
    logsource = rule.get("logsource")
    if not isinstance(logsource, dict):
        raise UnsupportedRule("missing/invalid logsource")

    product = str(logsource.get("product", "")).lower()
    category = str(logsource.get("category", "")).lower()
    service = str(logsource.get("service", "")).lower()

    if product and product != "windows":
        raise UnsupportedRule(f"unsupported product: {product}")

    # Service fallback for common PowerShell rules.
    if not category and service in {"powershell", "powershell-classic"}:
        category = "ps_script"

    if category not in LOGSOURCE_MAP:
        raise UnsupportedRule(
            f"unsupported or missing Windows logsource category: {category or '(none)'}"
        )

    return LOGSOURCE_MAP[category]


def mitre_ids(tags: Any) -> list[str]:
    if not isinstance(tags, list):
        return []

    result = []
    for tag in tags:
        text = str(tag).lower()
        match = re.fullmatch(r"attack\.(t\d{4}(?:\.\d{3})?)", text)
        if match:
            result.append(match.group(1).upper())

    return sorted(set(result))


def safe_group(value: str) -> str:
    value = value.lower()
    value = re.sub(r"[^a-z0-9_]+", "_", value)
    return value.strip("_")[:60]


class RuleIdRegistry:
    def __init__(self, path: Path):
        self.path = path
        self.map: dict[str, int] = {}

        if path.exists():
            try:
                raw = json.loads(path.read_text(encoding="utf-8"))
                self.map = {str(k): int(v) for k, v in raw.items()}
            except Exception:
                self.map = {}

        self.used = set(self.map.values())

    def get(self, key: str) -> int:
        if key in self.map:
            return self.map[key]

        for candidate in range(RULE_ID_MIN, RULE_ID_MAX + 1):
            if candidate not in self.used:
                self.map[key] = candidate
                self.used.add(candidate)
                return candidate

        raise RuntimeError("GSC Sigma Wazuh rule-ID range is exhausted")

    def save(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        temp = self.path.with_suffix(".tmp")
        temp.write_text(
            json.dumps(self.map, indent=2, sort_keys=True),
            encoding="utf-8",
        )
        temp.replace(self.path)


def rule_identity(rule: dict[str, Any], path: Path) -> str:
    sigma_id = rule.get("id")
    if sigma_id:
        return str(sigma_id)

    seed = f"{path}:{rule.get('title', '')}"
    return hashlib.sha256(seed.encode()).hexdigest()[:32]


def read_sigma_documents(path: Path) -> list[dict[str, Any]]:
    try:
        with path.open("r", encoding="utf-8") as handle:
            docs = list(yaml.safe_load_all(handle))
    except Exception as exc:
        raise UnsupportedRule(f"YAML parse error: {exc}")

    return [doc for doc in docs if isinstance(doc, dict)]


def should_include_upstream(rule: dict[str, Any]) -> tuple[bool, str]:
    """
    Keep automatic SigmaHQ content conservative by default.

    Environment overrides:
      GSC_SIGMA_MIN_LEVEL=low|medium|high|critical
      GSC_SIGMA_INCLUDE_EXPERIMENTAL=1
    """

    min_level = os.environ.get("GSC_SIGMA_MIN_LEVEL", "high").lower()
    include_experimental = (
        os.environ.get("GSC_SIGMA_INCLUDE_EXPERIMENTAL", "0") == "1"
    )

    order = {
        "informational": 0,
        "low": 1,
        "medium": 2,
        "high": 3,
        "critical": 4,
    }

    level = str(rule.get("level", "medium")).lower()
    status = str(rule.get("status", "")).lower()

    if order.get(level, 2) < order.get(min_level, 2):
        return False, f"below upstream minimum level ({min_level})"

    if status == "experimental" and not include_experimental:
        return False, "experimental upstream rule"

    return True, ""


def collect_rule_files(include_upstream: bool) -> list[tuple[Path, str]]:
    items: list[tuple[Path, str]] = []

    if include_upstream and UPSTREAM_DIR.exists():
        for path in sorted(UPSTREAM_DIR.rglob("*.yml")):
            items.append((path, "upstream"))
        for path in sorted(UPSTREAM_DIR.rglob("*.yaml")):
            items.append((path, "upstream"))

    # Manual rules come last so duplicate Sigma IDs can be overridden locally.
    if MANUAL_DIR.exists():
        for path in sorted(MANUAL_DIR.rglob("*.yml")):
            items.append((path, "manual"))
        for path in sorted(MANUAL_DIR.rglob("*.yaml")):
            items.append((path, "manual"))

    return items


def xml_rule(
    rule_id: int,
    level: int,
    title: str,
    provider_regex: str | None,
    event_regex: str,
    conditions: list[tuple[str, str]],
    tags: Any,
) -> str:

    title_xml = escape(title)

    lines = [
        f'  <rule id="{rule_id}" level="{level}">',
        "    <if_group>windows</if_group>",
    ]

    if provider_regex:
        lines.append(
            '    <field name="win.system.providerName" type="pcre2">'
            + escape(provider_regex)
            + "</field>"
        )

    lines.append(
        '    <field name="win.system.eventID" type="pcre2">'
        + escape(event_regex)
        + "</field>"
    )

    for field, pattern in conditions:
        lines.append(
            f'    <field name="{escape(field)}" type="pcre2">'
            + escape(pattern)
            + "</field>"
        )

    lines.append(f"    <description>Sigma: {title_xml}</description>")

    ids = mitre_ids(tags)
    if ids:
        lines.append("    <mitre>")
        for mitre_id in ids:
            lines.append(f"      <id>{escape(mitre_id)}</id>")
        lines.append("    </mitre>")

    level_group = {
        12: "sigma_critical",
        10: "sigma_high",
        7: "sigma_medium",
        5: "sigma_low",
        3: "sigma_informational",
    }.get(level, "sigma_medium")

    tactic_groups = []
    if isinstance(tags, list):
        for tag in tags:
            tag_text = str(tag)
            if tag_text.lower().startswith("attack."):
                tactic_groups.append(safe_group(tag_text.replace(".", "_")))

    groups = ["gsc_sigma", "sigma", level_group] + tactic_groups
    groups = [g for g in groups if g]

    lines.append("    <group>" + ",".join(sorted(set(groups))) + ",</group>")
    lines.append("  </rule>")

    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--include-upstream",
        action="store_true",
        help="Compile supported rules from /opt/gsc-sigma/upstream too.",
    )
    args = parser.parse_args()

    registry = RuleIdRegistry(ID_STATE_FILE)

    compiled: list[str] = []
    report = {
        "compiled_rules": [],
        "skipped_rules": [],
        "source_files": 0,
    }

    # Keyed by Sigma ID so manual rules can replace upstream rules.
    chosen: dict[str, tuple[dict[str, Any], Path, str]] = {}

    for path, source in collect_rule_files(args.include_upstream):
        report["source_files"] += 1

        try:
            docs = read_sigma_documents(path)
        except UnsupportedRule as exc:
            report["skipped_rules"].append(
                {
                    "file": str(path),
                    "source": source,
                    "reason": str(exc),
                }
            )
            continue

        for doc in docs:
            identity = rule_identity(doc, path)

            if source == "upstream":
                include, reason = should_include_upstream(doc)
                if not include:
                    report["skipped_rules"].append(
                        {
                            "file": str(path),
                            "source": source,
                            "sigma_id": identity,
                            "title": doc.get("title", ""),
                            "reason": reason,
                        }
                    )
                    continue

            # Manual rules overwrite same-ID upstream rule.
            chosen[identity] = (doc, path, source)

    # Manual rules are never subject to the upstream quantity cap. Select the
    # highest-severity upstream rules deterministically, then cap the set so a
    # content update cannot unexpectedly overwhelm Wazuh startup.
    upstream_identities = [
        identity for identity, (rule, _path, source) in chosen.items()
        if source == "upstream"
    ]
    upstream_identities.sort(
        key=lambda identity: (
            -LEVEL_MAP.get(
                str(chosen[identity][0].get("level", "medium")).lower(), 7
            ),
            str(chosen[identity][0].get("title", "")).lower(),
            identity,
        )
    )
    allowed_upstream = set(upstream_identities[:MAX_UPSTREAM_RULES])

    for identity in upstream_identities[MAX_UPSTREAM_RULES:]:
        rule, path, source = chosen[identity]
        report["skipped_rules"].append(
            {
                "file": str(path),
                "source": source,
                "sigma_id": identity,
                "title": rule.get("title", ""),
                "reason": (
                    "upstream safety cap reached "
                    f"({MAX_UPSTREAM_RULES} selected rules)"
                ),
            }
        )

    selected_identities = [
        identity for identity, (_rule, _path, source) in chosen.items()
        if source != "upstream" or identity in allowed_upstream
    ]

    for identity in sorted(selected_identities):
        rule, path, source = chosen[identity]
        title = str(rule.get("title", path.name))
        level_name = str(rule.get("level", "medium")).lower()
        level = LEVEL_MAP.get(level_name, 7)

        # Sigma correlation rules are not converted in v1.
        if "correlation" in rule:
            report["skipped_rules"].append(
                {
                    "file": str(path),
                    "source": source,
                    "sigma_id": identity,
                    "title": title,
                    "reason": "Sigma correlation rules are unsupported in v1",
                }
            )
            continue

        detection = rule.get("detection")

        try:
            if not isinstance(detection, dict):
                raise UnsupportedRule("missing/invalid detection section")

            provider_regex, event_regex = logsource_constraints(rule)
            branches = condition_to_branches(detection)

            if not branches:
                raise UnsupportedRule("condition produced no branches")

            for branch_index, branch in enumerate(branches):
                id_key = f"{identity}:{branch_index}"
                wazuh_id = registry.get(id_key)

                rendered_rule = xml_rule(
                    rule_id=wazuh_id,
                    level=level,
                    title=title,
                    provider_regex=provider_regex,
                    event_regex=event_regex,
                    conditions=branch,
                    tags=rule.get("tags", []),
                )

                longest_line = max(
                    (len(line) for line in rendered_rule.splitlines()),
                    default=0,
                )
                if longest_line > MAX_XML_LINE_LENGTH:
                    raise UnsupportedRule(
                        "generated XML line too long for Wazuh: "
                        f"{longest_line} characters "
                        f"(limit {MAX_XML_LINE_LENGTH})"
                    )

                compiled.append(rendered_rule)

                report["compiled_rules"].append(
                    {
                        "file": str(path),
                        "source": source,
                        "sigma_id": identity,
                        "title": title,
                        "branch": branch_index,
                        "wazuh_rule_id": wazuh_id,
                        "level": level,
                    }
                )

        except UnsupportedRule as exc:
            report["skipped_rules"].append(
                {
                    "file": str(path),
                    "source": source,
                    "sigma_id": identity,
                    "title": title,
                    "reason": str(exc),
                }
            )

    registry.save()

    GENERATED_DIR.mkdir(parents=True, exist_ok=True)

    xml = [
        "<group name=\"gsc_sigma,sigma,\">",
        "",
        "  <!--",
        "    AUTO-GENERATED by Granite Shield Cyber Sigma compiler.",
        "    Do not edit this XML directly; edit Sigma YAML in:",
        "      /opt/gsc-sigma/manual/",
        "  -->",
        "",
    ]

    xml.extend(compiled)
    xml.append("")
    xml.append("</group>")
    xml.append("")

    OUTPUT_FILE.write_text("\n".join(xml), encoding="utf-8")

    REPORT_FILE.write_text(
        json.dumps(report, indent=2, sort_keys=True),
        encoding="utf-8",
    )

    print(f"Source files considered: {report['source_files']}")
    print(f"Wazuh rules generated:   {len(report['compiled_rules'])}")
    print(f"Sigma rules skipped:     {len(report['skipped_rules'])}")
    print(f"Generated XML:           {OUTPUT_FILE}")
    print(f"Compatibility report:    {REPORT_FILE}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
